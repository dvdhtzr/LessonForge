{
  "LessonForge": {
    "Sources": {
      // Sources potentially usable in commercial applications under their
      // individual reviewed scopes. Attribution/share-alike conditions still
      // apply where required; individual exceptions and media are excluded.
      "wikipedia-text": true,                 // CC BY-SA 4.0: encyclopedia text
      "wikibooks-text": true,                 // CC BY-SA 4.0: instructional page text
      "usgs-earthquakes": true,               // U.S. government observations
      "loc-century-of-lawmaking": true,       // Public-domain catalog descriptions
      "gutenberg-catalog": true,              // Public-domain catalog metadata ONLY
      "smithsonian-openaccess-metadata": true, // Per-record CC0 catalog metadata ONLY

      // NONCOMMERCIAL and ADDITIONAL AI PERMISSION REQUIRED.
      // OpenStax book pages state that ingestion into LLM/generative-AI
      // offerings requires prior written permission, even for noncommercial
      // use. This is deliberately blocked at startup if changed to true.
      // No OpenStax book text is downloaded, embedded, or passed to Ollama.
      "openstax-text": false                  // CC BY-NC-SA 4.0 + AI restriction
    }
  }
}
